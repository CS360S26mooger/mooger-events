@startuml BetterCAPS_Class_Diagram

' ════════════════════════════════════════
'  LAYOUT — top-to-bottom, lightweight (no ortho, minimal hidden spine)
' ════════════════════════════════════════
top to bottom direction

skinparam classAttributeIconSize 0
skinparam classFontSize 10
skinparam packageFontSize 12
skinparam nodesep 30
skinparam ranksep 50
skinparam packageStyle rectangle
skinparam shadowing false
hide circle

title BetterCAPS — Phase 3 UML Class Diagram (Sprints 1–11)\nPackage: com.example.moogerscouncil

' ════════════════════════════════════════
'  LAYER 1 — CONSTANTS
' ════════════════════════════════════════
package "Constants" #E8F5E9 {
  class UserRole <<final>> {
    + {static} STUDENT : String
    + {static} COUNSELOR : String
    + {static} ADMIN : String
  }
  class SpecializationTags <<final>> {
    + {static} ANXIETY : String
    + {static} ACADEMIC_STRESS : String
    + {static} GRIEF : String
    + {static} RELATIONSHIPS : String
    + {static} CAREER_GUIDANCE : String
    + {static} DEPRESSION : String
    + {static} TRAUMA : String
    + {static} FAMILY_ISSUES : String
    + {static} ALL_TAGS : String[]
  }
}

' ════════════════════════════════════════
'  LAYER 2 — CORE MODELS
' ════════════════════════════════════════
package "Core Models" #F5F5DC {
  class Student {
    - uid : String
    - name : String
    - email : String
    - preferredName : String
    - pronouns : String
    - role : String
    - createdAt : Timestamp
    --
    + Student()
    + getters / setters
  }
  class Counselor {
    - id : String
    - uid : String
    - name : String
    - bio : String
    - specializations : List<String>
    - language : String
    - gender : String
    - isOnLeave : Boolean
    - referralCounselorId : String
    --
    + getters / setters
  }
  class Appointment {
    - id : String
    - studentId : String
    - counselorId : String
    - slotId : String
    - date : String
    - time : String
    - status : String
    --
    + getters / setters
  }
  class TimeSlot {
    - id : String
    - counselorId : String
    - date : String
    - time : String
    - available : boolean
    --
    + book()
    + getters / setters
  }
  class FeedbackService {
    - id : String
    - appointmentId : String
    - rating : int
    - comment : String
    - submittedAt : Timestamp
    --
    + getters / setters
  }
  class AvailabilitySchedule {
    - counselorId : String
    - slotsByDate : Map<String, List<TimeSlot>>
    --
    + {static} fromSlots(cId, slots)
    + getSlotsForDate(date) : List<TimeSlot>
    + getDatesWithAvailability() : Set<String>
  }
}

' ════════════════════════════════════════
'  LAYER 3 — FEATURE MODELS (Sprints 7–11)
' ════════════════════════════════════════
package "Feature Models" #FFF9C4 {
  class AvailabilitySettings {
    - counselorId : String
    - bufferMinutes : int
    - externalCalendarEnabled : boolean
    - calendarProvider : String
    - exportIcsEnabled : boolean
    --
    + getters / setters
  }
  class SessionNote {
    - id : String
    - appointmentId : String
    - counselorId : String
    - studentId : String
    - templateKey : String
    - noteText : String
    - privateToCounselor : boolean
    --
    + getters / setters
  }
  class CrisisEscalation {
    - id : String
    - appointmentId : String
    - counselorId : String
    - studentId : String
    - severity : String
    - actionTaken : String
    - resolved : boolean
    --
    + getters / setters
  }
  class IntakeAssessment {
    - id : String
    - studentId : String
    - primaryConcern : String
    - duration : String
    - supportType : String
    - urgencyLevel : String
    - recommendedSpecializations : List<String>
    - matchedCounselorId : String
    - active : boolean
    --
    + getters / setters
  }
  class SecureMessage {
    - id : String
    - counselorId : String
    - studentId : String
    - senderId : String
    - senderRole : String
    - messageText : String
    - read : boolean
    --
    + getThreadId() : String
    + getters / setters
  }
  class WaitlistEntry {
    - id : String
    - studentId : String
    - counselorId : String
    - assessmentId : String
    - reason : String
    - preferredDates : List<String>
    - preferredStartTime : String
    - preferredEndTime : String
    - status : String
    --
    + getters / setters
  }
  class WaitlistOffer {
    - id : String
    - waitlistEntryId : String
    - slotId : String
    - status : String
    - offeredAt : Timestamp
    - expiresAt : Timestamp
    --
    + getters / setters
  }
  class ReminderSettings {
    - enabled24Hour : boolean
    - enabled1Hour : boolean
    - message24Hour : String
    - message1Hour : String
    --
    + {static} defaultSettings() : ReminderSettings
    + getters / setters
  }
  class ReminderRecord {
    - id : String
    - appointmentId : String
    - studentId : String
    - reminderType : String
    - delivered : boolean
    - scheduledFor : Timestamp
    --
    + getters / setters
  }
}

' ════════════════════════════════════════
'  LAYER 4 — CORE REPOSITORIES
' ════════════════════════════════════════
package "Core Repositories" #E3F2FD {
  class UserRepository {
    + createUser(student, cb)
    + getCurrentUser(cb)
    + getUserName(uid, cb)
    + getCurrentUserRole(cb)
  }
  class CounselorRepository {
    + getAllCounselors(cb)
    + getCounselor(id, cb)
    + updateSpecializations(id, tags, cb)
    + updateCounselorProfile(id, c, cb)
    + setOnLeaveStatus(id, on, msg, refId, cb)
  }
  class AppointmentRepository {
    + bookAppointment(stuId, cId, slot, cb)
    + updateAppointmentStatus(apptId, status, cb)
    + cancelAppointment(apptId, slotId, cb)
    + getAppointmentsForCounselor(cId, cb)
    + getAppointmentsForStudent(stuId, cb)
    + getCompletedAppointmentsNeedingFeedback(stuId, cb)
  }
  class AvailabilityRepository {
    + getSlotsForCounselor(cId, cb)
    + getAvailableSlotsForCounselor(cId, cb)
    + addSlot(cId, date, time, cb)
    + removeSlot(slotId, cb)
  }
  class FeedbackRepository {
    + submitFeedback(fb, cb)
    + hasFeedbackForAppointment(apptId, cb)
  }
}

' ════════════════════════════════════════
'  LAYER 5 — FEATURE REPOSITORIES
' ════════════════════════════════════════
package "Feature Repositories" #DCEDC8 {
  class AvailabilitySettingsRepository {
    + getSettings(cId, cb)
    + saveSettings(settings, cb)
  }
  class ReminderRepository {
    + getSettings(cb)
    + saveSettings(settings, cb)
    + getDueRemindersForStudent(stuId, cb)
    + getPendingReminderCount(cb)
    + createReminderRecordIfMissing(appt, type, msg, when, cb)
  }
  class SessionNoteRepository {
    + getNoteForAppointment(cId, sId, apptId, cb)
    + getNotesForCounselorStudent(cId, sId, cb)
    + saveNote(note, cb)
    + updateNote(cId, sId, noteId, text, key, cb)
    + deleteNote(cId, sId, noteId, cb)
  }
  class CrisisEscalationRepository {
    + createEscalation(esc, cb)
    + getUnresolvedEscalations(cb)
    + markResolved(escId, cb)
  }
  class IntakeAssessmentRepository {
    + saveAssessment(a, cb)
    + updateMatchedCounselor(asmtId, cId, name, cb)
    + getLatestForStudent(stuId, cb)
    + getActiveForStudent(stuId, cb)
    + getRecommendationCounts(cb)
    + incrementRecommendationCount(cId)
  }
  class SecureMessageRepository {
    + getThreadMessages(cId, sId, cb)
    + listenToThread(cId, sId, cb)
    + hasUnreadInThread(cId, sId, role, cb)
    + sendMessage(cId, sId, date, time, sender, role, text, cb)
    + markThreadRead(cId, sId, role, cb)
  }
  class WaitlistRepository {
    + joinWaitlist(entry, cb)
    + resolveEntry(entryId, slotId, apptId, cb)
    + cancelEntry(entryId, cb)
    + getActiveWaitlistForStudent(stuId, cb)
    + getActiveWaitlistForCounselor(cId, cb)
    + getActiveWaitlistCountForCounselor(cId, cb)
  }
}

' ════════════════════════════════════════
'  LAYER 6 — UTILITIES
' ════════════════════════════════════════
package "Utilities" #EDE7F6 {
  class BufferTimeValidator <<utility>> {
    + {static} hasConflict(slots, date, time, buf) : boolean
    + {static} parseMinutes(hhmm) : int
  }
  class IntakeMatcher <<utility>> {
    + {static} tagsForAnswers(c, s, u) : List<String>
    + {static} scoreCounselor(c, a) : int
    + {static} findBestCounselor(list, a) : Counselor
  }
  class WaitlistMatcher <<utility>> {
    + {static} matches(entry, date, time) : boolean
    + {static} findFirstMatch(entries, date, time) : WaitlistEntry
    + {static} findFirstMatchingSlot(slots, dates, s, e) : TimeSlot
  }
  class ReturningStudentHelper <<utility>> {
    + {static} markReturningStudents(appts)
    + {static} isReturningStudent(appts, current) : boolean
  }
  class CalendarSyncHelper <<utility>> {
    + {static} buildInsertEventIntent(appt, name) : Intent
    + {static} buildIcsLine(appt, name) : String
  }
  class NoteTemplate <<utility>> {
    + {static} getDisplayName(key) : String
    + {static} getTemplateText(key) : String
  }
  class AppToast <<utility>> {
    + {static} scheduleForNextActivity(msg, dur)
    + {static} consumePending(ctx)
    + {static} show(ctx, msg, dur)
  }
  class SessionCache <<singleton>> {
    + {static} getInstance() : SessionCache
    + getStudent(uid) / putStudent(s)
    + getCounselors() / putCounselors(list)
    + getStudentAppointments(stuId) / put...
    + getSlots(key) / putSlots(key, slots)
    + invalidateSlots(keys) / clearAll()
  }
  class ReminderScheduler {
    - reminderRepository : ReminderRepository
    - appointmentRepository : AppointmentRepository
    --
    + generateReminderRecords(cb)
  }
}

' ════════════════════════════════════════
'  LAYER 7 — ADAPTERS
' ════════════════════════════════════════
package "Adapters" #FFF3E0 {
  class CounselorAdapter {
    + setData(list)
    + onBindViewHolder(h, p)
  }
  class AppointmentAdapter {
    - userRepository : UserRepository
    - appointmentRepository : AppointmentRepository
    --
    + setData(list)
    - markNoShow(apt, h, p)
  }
  class StudentAppointmentAdapter {
    - counselorRepository : CounselorRepository
    --
    - statusLabel(s) : String
  }
  class TimeSlotAdapter {
    - listener : OnBookClickListener
    --
    + setData(slots)
  }
  interface "TimeSlotAdapter.OnBookClickListener" as OnBookClickListener {
    + onBookClick(slot)
  }
  class WaitlistAdapter {
    - cancelListener : OnCancelClickListener
  }
  class CounselorWaitlistAdapter {
    - slotListener : OnCreateSlotClickListener
  }
  class CrisisAlertAdapter {
    - repository : CrisisEscalationRepository
    --
    + setData(data)
  }
  class SecureMessageAdapter {
    - currentUid : String
    --
    + setMessages(msgs)
  }
  class SessionNoteHistoryAdapter {
  }
}

' ════════════════════════════════════════
'  LAYER 8 — SHARED UI
' ════════════════════════════════════════
package "Shared UI" #E0F7FA {
  class CustomCalendarView <<View>> {
    - highlightedDates : Set<String>
    - selectedDates : Set<String>
    - listener : OnDateClickListener
    --
    + setHighlightedDates(dates)
    + setSelectedDates(dates)
    + setOnDateClickListener(l)
    + setMinDate(ms)
    + getSelectedDate() : String
  }
  class EmergencyDialogFragment <<Dialog>> {
    + {static} newInstance()
    - dialNumber(num)
  }
  class CrisisEscalationDialogFragment <<Dialog>> {
    + {static} newInstance(apptId, cId, sId)
    + onCreateDialog(s) : Dialog
  }
}

' ════════════════════════════════════════
'  LAYER 9 — AUTH FLOW
' ════════════════════════════════════════
package "Auth Flow" #FCE4EC {
  class MainActivity <<Activity>>
  class LoginActivity <<Activity>> {
    - userRepository : UserRepository
    --
    - attemptLogin()
    - routeToHome(role)
  }
  class RegisterActivity <<Activity>> {
    - userRepository : UserRepository
    --
    - attemptRegistration()
    - validateInputs() : boolean
  }
  class PrivacyPolicyActivity <<Activity>> {
    + {static} EXTRA_ROLE : String
    --
    - routeToHome(role)
  }
}

' ════════════════════════════════════════
'  LAYER 10 — STUDENT UI
' ════════════════════════════════════════
package "Student UI" #E8EAF6 {
  class StudentHomeActivity <<Activity>> {
    - upcomingAppointment : Appointment
    --
    - fetchUpcomingSession()
    - handleCancellation()
    - checkForPendingFeedback()
    - activateDiscreetMode()
  }
  class BookingActivity <<Activity>> {
    - schedule : AvailabilitySchedule
    --
    - loadSlots(date)
    + onBookClick(slot)
  }
  class BookingConfirmationFragment <<BottomSheet>> {
    + {static} newInstance(name, slot)
    + setOnConfirmListener(l)
  }
  class CalendarActivity <<Activity>> {
    - fetchAppointmentsForDate(date)
  }
  class HistoryActivity <<Activity>> {
    - fetchHistory()
  }
  class QuizActivity <<Activity>> {
    - startMatching(spec)
  }
  class StudentWaitlistActivity <<Activity>> {
    - loadEntries()
    - confirmCancel(entry)
  }
  class WaitlistRequestActivity <<Activity>> {
    - validateAndSubmit()
    - submitWaitlistEntry(s, e)
  }
  class ReminderSettingsActivity <<Activity>> {
    - loadSettings() / saveSettings()
  }
  class SessionHistoryActivity <<Activity>> {
    - loadHistory(stuId)
  }
  class StudentProfileActivity <<Activity>> {
    - loadStudent()
    - loadLatestIntake()
    - loadSessionNotes()
  }
}

' ════════════════════════════════════════
'  LAYER 11 — COUNSELOR UI
' ════════════════════════════════════════
package "Counselor UI" #F3E5F5 {
  class CounselorDashboardActivity <<Activity>> {
    - loadAppointments()
    - filterByTab(idx)
  }
  class CounselorListActivity <<Activity>> {
    - loadCounselors()
    - applyFilters()
  }
  class CounselorProfileActivity <<Activity>> {
    - loadProfile()
  }
  class CounselorProfileEditActivity <<Activity>> {
    - loadCurrentProfile()
    - saveProfile()
  }
  class AvailabilitySetupActivity <<Activity>> {
    - loadSlots()
    - addSlot(date, time)
  }
  class AddSlotActivity <<Activity>> {
    - confirmCreateSlot()
    - tryAutoResolveWaitlist(slot)
  }
  class GenerateSlotsActivity <<Activity>> {
    - computeAndConfirm(dur, buf)
    - doGenerateSlots(perDate, total)
  }
  class AvailabilitySettingsActivity <<Activity>> {
    - loadSettings() / saveSettings()
  }
  class CounselorWaitlistActivity <<Activity>> {
    - loadQueue()
    - createSlotAndResolve(entry, d, t, dlg)
  }
  class ManageSessionActivity <<Activity>> {
    + onEscalationSaved(escId)
    - loadNotes()
    - openMessages()
    - openCrisisDialog()
  }
  class MessageThreadActivity <<Activity>> {
    - subscribeToMessages()
    - markRead() / sendMessage()
  }
  class SessionNoteActivity <<Activity>> {
    + {static} newIntent(...)
    - applyTemplate(key)
    - saveNote() / deleteNote()
  }
  class PastSessionsActivity <<Activity>> {
    - loadPastSessions()
  }
}

' ════════════════════════════════════════
'  LAYER 12 — ADMIN UI
' ════════════════════════════════════════
package "Admin UI" #FFCDD2 {
  class AdminDashboardActivity <<Activity>> {
    - reminderScheduler : ReminderScheduler
    --
    - loadReminderSummary()
    - generateReminderRecords()
    - loadCrisisAlerts()
  }
}

' ════════════════════════════════════════
'  RELATIONSHIPS — curated, high-signal only
' ════════════════════════════════════════

' Models
Student ..> UserRole
AvailabilitySchedule o-- TimeSlot
Counselor ..> Counselor
WaitlistOffer ..> WaitlistEntry
WaitlistOffer ..> TimeSlot
TimeSlotAdapter +-- OnBookClickListener

' Repo → Model (one each)
UserRepository ..> Student
CounselorRepository ..> Counselor
AppointmentRepository ..> Appointment
AvailabilityRepository ..> TimeSlot
FeedbackRepository ..> FeedbackService
AvailabilitySettingsRepository ..> AvailabilitySettings
ReminderRepository ..> ReminderSettings
SessionNoteRepository ..> SessionNote
CrisisEscalationRepository ..> CrisisEscalation
IntakeAssessmentRepository ..> IntakeAssessment
SecureMessageRepository ..> SecureMessage
WaitlistRepository ..> WaitlistEntry

' Util ↔ key collaborators
IntakeMatcher ..> Counselor
IntakeMatcher ..> IntakeAssessment
WaitlistMatcher ..> WaitlistEntry
ReminderScheduler ..> ReminderRepository
SessionCache ..> Student

' Adapters → models
CounselorAdapter ..> Counselor
AppointmentAdapter ..> Appointment
StudentAppointmentAdapter ..> Appointment
TimeSlotAdapter ..> TimeSlot
WaitlistAdapter ..> WaitlistEntry
CounselorWaitlistAdapter ..> WaitlistEntry
CrisisAlertAdapter ..> CrisisEscalation
SecureMessageAdapter ..> SecureMessage
SessionNoteHistoryAdapter ..> SessionNote

' Auth flow
MainActivity ..> LoginActivity
LoginActivity ..> StudentHomeActivity
LoginActivity ..> CounselorDashboardActivity
RegisterActivity ..> PrivacyPolicyActivity

' Student UI → repos / shared
StudentHomeActivity ..> AppointmentRepository
StudentHomeActivity ..> EmergencyDialogFragment
BookingActivity ..> AvailabilityRepository
BookingActivity ..> TimeSlotAdapter
BookingActivity ..|> OnBookClickListener
QuizActivity ..> IntakeMatcher
QuizActivity ..> IntakeAssessmentRepository
StudentWaitlistActivity ..> WaitlistRepository
WaitlistRequestActivity ..> WaitlistRepository
WaitlistRequestActivity ..> CustomCalendarView
ReminderSettingsActivity ..> ReminderRepository
StudentProfileActivity ..> SessionNoteRepository

' Counselor UI → repos / shared
CounselorDashboardActivity ..> AppointmentRepository
CounselorListActivity ..> CounselorRepository
CounselorListActivity ..> SpecializationTags
AvailabilitySetupActivity ..> AvailabilityRepository
AvailabilitySetupActivity ..> BufferTimeValidator
AddSlotActivity ..> WaitlistMatcher
GenerateSlotsActivity ..> BufferTimeValidator
CounselorWaitlistActivity ..> WaitlistRepository
ManageSessionActivity ..> SessionNoteRepository
ManageSessionActivity ..> CrisisEscalationDialogFragment
MessageThreadActivity ..> SecureMessageRepository
SessionNoteActivity ..> NoteTemplate

' Admin UI
AdminDashboardActivity ..> ReminderRepository
AdminDashboardActivity ..> CrisisEscalationRepository
AdminDashboardActivity ..> ReminderScheduler

' ════════════════════════════════════════
'  HIDDEN VERTICAL SPINE — one link per package transition
' ════════════════════════════════════════
UserRole                     -[hidden]down- Student
AvailabilitySchedule         -[hidden]down- AvailabilitySettings
ReminderRecord               -[hidden]down- UserRepository
FeedbackRepository           -[hidden]down- AvailabilitySettingsRepository
WaitlistRepository           -[hidden]down- BufferTimeValidator
ReminderScheduler            -[hidden]down- CounselorAdapter
SessionNoteHistoryAdapter    -[hidden]down- CustomCalendarView
CrisisEscalationDialogFragment -[hidden]down- MainActivity
PrivacyPolicyActivity        -[hidden]down- StudentHomeActivity
StudentProfileActivity       -[hidden]down- CounselorDashboardActivity
PastSessionsActivity         -[hidden]down- AdminDashboardActivity

@enduml
